# Reference for Render Environment settings. This file is not loaded automatically.
# Do not import Backend/.env or root .env into Render: they contain local settings.
SPRING_PROFILES_ACTIVE=cloud
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# validate for an existing initialized database; update ONCE for a new empty demo DB.
JPA_DDL_AUTO=validate

# Native Redis hostname/password, not UPSTASH_REDIS_REST_URL/TOKEN.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_PROVIDER=resend
RESEND_API_KEY=
# Use onboarding@resend.dev ONLY for sending to the Resend account's own email.
# For real multi-user OTP, use an address on a verified domain.
MAIL_FROM=

# Render Blueprint generates JWT_SECRET; use a stable base64-encoded 32-byte secret otherwise.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_API_KEY=

DEV_MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
DEV_ACCESS_KEY=
DEV_PARTNER_CODE=
DEV_SECRET_KEY=
# Omit redirect/IPN variables entirely on Render. application-cloud.properties uses RENDER_EXTERNAL_URL.
# Do not add blank DEV_MOMO_REDIRECT_URL / DEV_MOMO_IPN_URL variables there.
