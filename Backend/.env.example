# AES Encryption Secret Key (32 bytes / 32 characters)
APP_SECURITY_SECRET_KEY=your_32_character_secret_key_here

# Fill these only after the backend has a real public HTTPS URL.
# Use scripts/configure-momo.ps1 to derive URLs without changing credentials.
DEV_MOMO_REDIRECT_URL=
DEV_MOMO_IPN_URL=
# Empty reuses the web redirect. Register Android App Links before using a custom scheme.
DEV_MOMO_MOBILE_REDIRECT_URL=
# Optional simulated SePay bank-transfer provider (never use a real bank account for this demo).
PAYMENT_PROVIDER=momo
SEPAY_BANK_CODE=VCB
SEPAY_BANK_NAME=Vietcombank
SEPAY_ACCOUNT_NUMBER=0000000001
# Optional official simulated VA; must exactly match webhook subAccount.
SEPAY_VIRTUAL_ACCOUNT=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_AUTH_MODE=hmac
SEPAY_WEBHOOK_API_KEY=
